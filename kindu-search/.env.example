# Kindu Search — Étapes 5-6 (stock live, admin, dons, PWA)
# Copiez ce fichier vers .env.local et renseignez vos valeurs.
# Sans configuration Supabase, l'application utilise les données de démo
# et le pont local /api/stock-live (si KND OS est configuré dessus).

NEXT_PUBLIC_SUPABASE_URL=
# Clé publishable (sb_publishable_...), sûre côté navigateur.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Jeton du pont de démonstration local. Doit correspondre au jeton envoyé par
# KND OS (EXPO_PUBLIC_KND_SYNC_TOKEN). Uniquement pour la démo locale.
DEMO_SYNC_TOKEN=demo-sync-token-kay

# Active le pont /api/stock-live (serveur) et son polling (navigateur).
# À laisser désactivé sur un déploiement public.
DEMO_BRIDGE_ENABLED=true
NEXT_PUBLIC_DEMO_BRIDGE=true

# Étape 6 — Admin / Don / PWA
# Code d'accès /admin. La valeur de démonstration est `kay-demo`.
# En production, définir un code long et ADMIN_SESSION_SECRET.
ADMIN_ACCESS_CODE=kay-demo
ADMIN_SESSION_SECRET=
# Clé secrète serveur (sb_secret_...), jamais NEXT_PUBLIC_. Sans elle, /admin
# fonctionne en mode démo local. Ne jamais committer la vraie clé.
SUPABASE_SERVICE_ROLE_KEY=
# Numéro WhatsApp Mobile Money pour les dons manuels V1. [À CONFIRMER]
NEXT_PUBLIC_DONATION_WHATSAPP=243970000101
# Affiche le code de démo sur /admin. Passer à false en production.
NEXT_PUBLIC_ADMIN_DEMO_HINT=true
