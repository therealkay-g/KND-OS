# KND OS — Étape 5 (stock live)
# Copiez ce fichier vers .env.local et renseignez vos valeurs.
# Sans configuration, KND OS reste 100 % local (comportement des Étapes 1-4).

# Option A — Supabase (production)
EXPO_PUBLIC_SUPABASE_URL=
# Clé publishable (sb_publishable_...), sûre côté application.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Jeton du commerce, généré côté admin/Supabase. Ne pas livrer en production
# sans remplacer par l'authentification commerçant (docs/05-backend.md).
EXPO_PUBLIC_KND_SYNC_TOKEN=
# Active l'envoi du stock live pour le commerce de démonstration.
EXPO_PUBLIC_KND_OS_PRO=false

# Option B — Pont de démonstration local, sans Supabase.
# Kindu Search doit tourner sur http://127.0.0.1:3000.
EXPO_PUBLIC_STOCK_BRIDGE_URL=
